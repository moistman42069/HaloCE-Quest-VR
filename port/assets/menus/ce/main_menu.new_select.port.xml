	<widget name="main_menu/new_select/list_item_0_map_kind_spinner" type="spinner" width="256" height="28" flags="left_right_tabs_items" string_list="main_menu/new_select/var_map_kinds" font="ui\large_ui" color="#FF2896FF" align="center" text_y="3" list_flags="items_from_strings" header_bitmap="bitmaps/arrow_sm_left" footer_bitmap="bitmaps/arrow_sm_right" header_bounds="9 3 21 9" footer_bounds="9 247 21 253">
