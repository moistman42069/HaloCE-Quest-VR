	</widget>
	<strings name="main_menu/new_select/var_map_kinds">
		<string text="SINGLEPLAYER"/>
		<string text="MULTIPLAYER"/>
		<string text="CUSTOM SINGLEPLAYER"/>
		<string text="CUSTOM MULTIPLAYER"/>
	</strings>
</menus>
